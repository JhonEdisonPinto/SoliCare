# Public URL of the SoliCare backend (no trailing slash).
VITE_API_URL=http://localhost:8080
# Default data source until someone uses the "Datos reales" switch (kept in localStorage as solicare.dataMode).
# true starts with seeded, simulated telemetry labelled "Modo demostración"; false starts with the real devices.
VITE_DEMO_MODE=false
