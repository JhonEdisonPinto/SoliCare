NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://solicare:password@localhost:5432/solicare
DEVICE_INGEST_TOKEN=replace-with-a-long-random-token
# Optional key of the web panel (people, contacts, alerts attended). While empty the panel is open:
# anyone with the link reads and edits the care data. Set a long random value to require the key again.
PANEL_TOKEN=
# Optional Telegram bot for the "Simular caída" button (see backend/README.md). Both empty: the
# simulation only shows on screen. The token is a secret; the chat id of a group starts with -.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORS_ORIGIN=http://localhost:5173
